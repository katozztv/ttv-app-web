# Discord OAuth2 (ใช้ Discord app เดิมได้ แต่ต้องเพิ่ม Redirect URL ของ TTV)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=https://ttv-app.vercel.app
NEXTAUTH_SECRET=

# Supabase (ตาราง ttv_task)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ต้องตรงกับ x-api-key ใน desktop/main.js
API_SECRET_KEY=   # ดูค่าในไฟล์ API_SECRET_KEY.txt ที่โฟลเดอร์ TTV APP

# Discord webhook ห้องแจ้งเตือนแลกคูปองของ TTV
DISCORD_WEBHOOK_URL=
